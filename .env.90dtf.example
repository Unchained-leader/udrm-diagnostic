# ═══════════════════════════════════════════════════════════════
# 90DTF (90-Day Transformation) — Environment Variables
# Independent copy of the UDRM app. Copy to .env.local in the 90dtf repo,
# or paste into the 90dtf Vercel project's Environment Variables.
#
# RULE OF THUMB: every value here is BRAND NEW and separate from the live
# UDRM app, EXCEPT the DATABASE_URL group (the shared analytics DB).
# ═══════════════════════════════════════════════════════════════

# ── Core App ──
NEXT_PUBLIC_APP_URL=https://90dtf.unchainedleader.io
JWT_SECRET=GENERATE-A-NEW-RANDOM-SECRET   # do NOT reuse the UDRM secret

# Product tag — this is the one line that separates 90dtf data in analytics.
PRODUCT_TAG=90dtf

# ── AI / Claude ── (new key recommended for clean cost separation)
ANTHROPIC_API_KEY=sk-ant-NEW-90dtf-key

# ── Database (Neon PostgreSQL) ── *** THE ONLY SHARED RESOURCE ***
# Reuse the EXACT same values as the live UDRM app so 90dtf results appear
# in the Unchained Analytics dashboard. 90dtf only INSERTs rows tagged
# product='90dtf'; it never touches product='udrm' rows.
DATABASE_URL=<SAME AS LIVE UDRM>
POSTGRES_URL=<SAME AS LIVE UDRM>
POSTGRES_URL_NON_POOLING=<SAME AS LIVE UDRM>

# ── Cache / Session Store (Upstash Redis) ── NEW, separate database
KV_REST_API_URL=https://your-NEW-90dtf-redis.upstash.io
KV_REST_API_TOKEN=NEW-90dtf-redis-token

# ── Queue (Upstash QStash) ── NEW tokens; QStash must target the 90dtf domain
QSTASH_TOKEN=NEW-90dtf-qstash-token
QSTASH_CURRENT_SIGNING_KEY=sig_NEW
QSTASH_NEXT_SIGNING_KEY=sig_NEW

# ── Email (Resend) ── NEW key; verify the 90dtf sending domain/subdomain
RESEND_API_KEY=re_NEW-90dtf-key
RESEND_FROM_EMAIL=90DTF <reports@90dtf.unchainedleader.io>

# ── CRM (GoHighLevel) ── NEW inbound webhooks for the 90dtf pipeline
GHL_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/NEW-90dtf
GHL_REPORT_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/NEW-90dtf-report

# ── Zapier ── new hook, or leave unset to disable
# ZAPIER_WEBHOOK_URL=

# ── Admin ── NEW credentials
ADMIN_PASSWORD=NEW-90dtf-admin-password
ADMIN_KEY=NEW-90dtf-admin-key

# ── Monitoring (Optional) ── new Slack channel/webhook, or leave unset
# SLACK_WEBHOOK_URL=
# ALERT_EMAIL=team@unchainedleader.com
